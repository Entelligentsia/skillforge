+        raise ValidationError("bad email")
+    if len(payload["password"]) < 12:
+        raise ValidationError("password too short")
+
+    user_id = db.insert("users", payload)
+
+    mailer.send_welcome(payload["email"], user_id)
+    audit.record("user.created", user_id)
+
+    return user_id
